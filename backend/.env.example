# Copy to .env and fill in. Never commit .env.
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Required for voice (Whisper) and LLM extraction. Without it, typed text still works
# through the local rule-based parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_STT_MODEL=whisper-1

# Groq (used instead of OpenAI when set) — OpenAI-compatible API.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3

# Spoken ride confirmation (/api/tts):
#   edge   (default) Microsoft Edge neural voices, no key needed (unofficial read-aloud service)
#   openai OpenAI tts-1, uses OPENAI_API_KEY above
#   none   the browser's own voices only
TTS_PROVIDER=edge
TTS_VOICE_AR=ar-SA-HamedNeural
TTS_VOICE_EN=en-US-ChristopherNeural
TTS_MODEL=tts-1
TTS_VOICE=onyx

# Whisper language: "auto" (default — detects Arabic / English from the audio) or force "ar" / "en".
STT_LANGUAGE=auto

# Public OSM services (fine for a demo; self-host for production traffic).
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://router.project-osrm.org
HTTP_USER_AGENT=PetraVoice/1.0 (hackathon demo)

DB_PATH=data/petravoice.db
